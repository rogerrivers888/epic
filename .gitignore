# No trailing slash: it must also match the symlinks a shipping worktree makes to the
# shared tree's node_modules (CLAUDE.md), which `node_modules/` — directories only — does not.
node_modules
.env
.env.local
.expo/
dist/
# Flag artwork copied out of country-flag-icons by apps/web/scripts/flags.mjs.
apps/web/public/flags/
web-build/
*.log
.DS_Store

# Working folders and scratch scripts: the root should show the app, not the
# history of building it (the estate's engineering standard, rule 11).
Supporting docs/
*-tmp.mjs

# One full test suite on this machine at a time (apps/api/test/helpers/suiteLock.mjs)
.epic-suite.lock
